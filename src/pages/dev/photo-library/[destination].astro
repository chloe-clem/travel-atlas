---
import { createHash } from 'node:crypto';
import { readFile, readdir, stat } from 'node:fs/promises';
import path from 'node:path';
import sharp from 'sharp';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDestinationExperience } from '../../../data/destinationExperiences';
import { getRecommendationsByDestination } from '../../../data/recommendations';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { destination: 'leiden' } }] : [];
}

const base = import.meta.env.BASE_URL;
const destination = Astro.params.destination;
if (destination !== 'leiden') throw new Error('Unsupported developer photo-library destination.');
const photoDirectory = path.join(process.cwd(), 'public', 'photos', destination);
const supportedExtensions = new Set(['.jpg', '.jpeg', '.png', '.webp', '.avif']);
const heicExtensions = new Set(['.heic', '.heif']);
const filenames = await readdir(photoDirectory);
const alphabetical = (first: string, second: string) => first.localeCompare(second, 'en', { numeric: true, sensitivity: 'base' });
const supportedFilenames = filenames.filter(filename => supportedExtensions.has(path.extname(filename).toLowerCase())).sort(alphabetical);
const heicFiles = filenames.filter(filename => heicExtensions.has(path.extname(filename).toLowerCase())).sort(alphabetical);

interface CatalogPhoto {
  filename: string;
  publicPath: string;
  imageUrl: string;
  width: number;
  height: number;
  orientation: 'portrait' | 'landscape' | 'square';
  bytes: number;
  fileSize: string;
  hash: string;
}

const formatFileSize = (bytes: number) => {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 ** 2) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / 1024 ** 2).toFixed(1)} MB`;
};

const photos: CatalogPhoto[] = [];
const unreadableFiles: string[] = [];
for (const filename of supportedFilenames) {
  const absolutePath = path.join(photoDirectory, filename);
  try {
    const [fileStats, fileBuffer, metadata] = await Promise.all([
      stat(absolutePath),
      readFile(absolutePath),
      sharp(absolutePath).metadata(),
    ]);
    if (!metadata.width || !metadata.height) throw new Error('Missing image dimensions');
    const orientation = metadata.width === metadata.height ? 'square' : metadata.width > metadata.height ? 'landscape' : 'portrait';
    photos.push({
      filename,
      publicPath: `photos/${destination}/${filename}`,
      imageUrl: `${base}photos/${destination}/${encodeURIComponent(filename)}`,
      width: metadata.width,
      height: metadata.height,
      orientation,
      bytes: fileStats.size,
      fileSize: formatFileSize(fileStats.size),
      hash: createHash('sha256').update(fileBuffer).digest('hex'),
    });
  } catch {
    unreadableFiles.push(filename);
  }
}

const filenamesByHash = new Map<string, string[]>();
photos.forEach(photo => filenamesByHash.set(photo.hash, [...(filenamesByHash.get(photo.hash) ?? []), photo.filename]));
const duplicateGroups = [...filenamesByHash.values()].filter(group => group.length > 1);
const recommendations = getRecommendationsByDestination(destination).map(({ id, name }) => ({ id, name }));
const feelingOptions = [
  { id: 'wild', name: 'Wild' },
  { id: 'immersed', name: 'Immersed' },
  { id: 'inspired', name: 'Inspired' },
  { id: 'energized', name: 'Energized' },
  { id: 'relaxed', name: 'Relaxed' },
];
const experience = getDestinationExperience(destination);
const storyOptions = experience.stories.items.map((story, index) => ({
  id: `story-${index + 1}`,
  name: story.title,
}));
const existingAssignments = [
  { src: experience.hero.image, role: 'destination-hero', relatedId: destination, priority: '', alt: experience.hero.imageAlt, notes: 'Imported from the current Leiden destination hero.' },
  { src: experience.editorialTake.image, role: 'chloes-take', relatedId: destination, priority: '', alt: experience.editorialTake.imageAlt, notes: 'Imported from the current Leiden Chloe’s Take section.' },
  ...experience.stories.items.map((story, index) => ({
    src: story.image,
    role: 'story',
    relatedId: `story-${index + 1}`,
    priority: 'primary',
    alt: story.imageAlt,
    notes: `Imported from the current story: ${story.title}`,
  })),
];
const clientData = { destination, photos, recommendations, feelings: feelingOptions, stories: storyOptions, existingAssignments };
const clientScript = import.meta.env.DEV
  ? await readFile(path.join(process.cwd(), 'src', 'scripts', 'leidenPhotoCatalog.js'), 'utf8')
  : '';
const clientStyles = import.meta.env.DEV
  ? await readFile(path.join(process.cwd(), 'src', 'styles', 'leidenPhotoCatalog.css'), 'utf8')
  : '';
---

<BaseLayout title="Leiden Photo Assignment Library | Development Tool">
  <main class="photo-library">
    <header class="photo-library-header">
      <div class="eyebrow rust">Development tool</div>
      <h1>Leiden Photo Assignment Library</h1>
      <p>Review source photography, save draft assignments in this browser, and export validated JSON for a later content update.</p>
      <p class="sharp-note"><strong>Image safety:</strong> Sharp reads dimensions and orientation at build time only. It never edits, compresses, resizes, renames, or duplicates source photos.</p>
    </header>

    <section class="assignment-summary" aria-labelledby="summaryHeading">
      <div class="summary-heading">
        <div><div class="eyebrow rust">Draft status</div><h2 id="summaryHeading">Assignment overview</h2></div>
        <span id="exportState" class="export-state">No export yet</span>
      </div>
      <dl class="summary-grid">
        <div><dt>Total photos</dt><dd data-summary="total">{photos.length}</dd></div>
        <div><dt>Assigned</dt><dd data-summary="assigned">0</dd></div>
        <div><dt>Unassigned</dt><dd data-summary="unassigned">{photos.length}</dd></div>
        <div><dt>Do not use</dt><dd data-summary="do-not-use">0</dd></div>
        <div><dt>Destination hero</dt><dd data-summary="hero">Missing</dd></div>
        <div><dt>Chloe’s Take</dt><dd data-summary="take">Missing</dd></div>
        <div><dt>Feeling images</dt><dd data-summary="feelings">0</dd></div>
        <div><dt>Recommendation primaries</dt><dd data-summary="recommendation-primary">0</dd></div>
        <div><dt>Recommendations missing</dt><dd data-summary="recommendation-missing">{recommendations.length}</dd></div>
        <div><dt>Story images</dt><dd data-summary="stories">0</dd></div>
        <div class="validation-summary"><dt>Validation errors</dt><dd data-summary="errors">0</dd></div>
      </dl>
      <div class="summary-actions">
        <button type="button" id="importExisting">Import existing assignments into draft</button>
        <button type="button" id="exportJson" class="primary-action">Export JSON</button>
        <label class="file-action">Import JSON<input id="importJson" type="file" accept="application/json,.json" /></label>
        <button type="button" id="clearDraft" class="danger-action">Clear draft</button>
      </div>
      <p id="actionMessage" class="action-message" aria-live="polite"></p>
      <div id="validationErrors" class="validation-errors" role="alert" hidden></div>
    </section>

    <details class="existing-assignments">
      <summary>Review {existingAssignments.length} existing public assignments</summary>
      <p>These are read-only until you use the import button. A photo currently reused in more than one role must be resolved before export.</p>
      <ul>
        {existingAssignments.map(assignment => (
          <li><code>{assignment.src}</code><span>{assignment.role === 'destination-hero' ? 'Destination Hero' : assignment.role === 'chloes-take' ? 'Chloe’s Take' : `Story Image · ${storyOptions.find(story => story.id === assignment.relatedId)?.name}`}</span></li>
        ))}
      </ul>
    </details>

    <section aria-label="Photo library controls" class="library-controls">
      <label>Search by filename<input id="photoSearch" type="search" placeholder="Try IMG_3412" /></label>
      <label>Orientation<select id="orientationFilter"><option value="all">All orientations</option><option value="landscape">Landscape</option><option value="portrait">Portrait</option><option value="square">Square</option></select></label>
      <label>Assignment<select id="assignmentFilter"><option value="all">Assigned and unassigned</option><option value="assigned">Assigned</option><option value="unassigned">Unassigned</option></select></label>
      <label>Role<select id="roleFilter"><option value="all">All roles</option><option value="destination-hero">Destination Hero</option><option value="feeling">Feeling Image</option><option value="chloes-take">Chloe’s Take</option><option value="recommendation">Recommendation Image</option><option value="story">Story Image</option><option value="do-not-use">Do Not Use</option></select></label>
      <label>Recommendation<select id="recommendationFilter"><option value="all">All recommendations</option>{recommendations.map(item => <option value={item.id}>{item.name}</option>)}</select></label>
      <label>Do not use<select id="doNotUseFilter"><option value="all">Include all</option><option value="only">Only do-not-use</option><option value="exclude">Exclude do-not-use</option></select></label>
      <label>Sort<select id="photoSort"><option value="ascending">Filename A–Z</option><option value="descending">Filename Z–A</option></select></label>
      <p aria-live="polite" id="photoCount">Showing {photos.length} photos.</p>
    </section>

    {(heicFiles.length > 0 || unreadableFiles.length > 0 || duplicateGroups.length > 0) && (
      <section class="library-notices" aria-label="Photo audit notices">
        {heicFiles.length > 0 && <div><h2>Unsupported HEIC / HEIF files</h2><p>{heicFiles.join(', ')}</p></div>}
        {unreadableFiles.length > 0 && <div><h2>Unreadable supported files</h2><p>{unreadableFiles.join(', ')}</p></div>}
        {duplicateGroups.length > 0 && <div><h2>Exact duplicate groups</h2>{duplicateGroups.map(group => <p>{group.join(' = ')}</p>)}</div>}
      </section>
    )}

    <section class="photo-grid" id="photoGrid" aria-label="Leiden photographs">
      {photos.map(photo => (
        <article class="photo-catalog-card" data-src={photo.publicPath} data-filename={photo.filename.toLowerCase()} data-orientation={photo.orientation} tabindex="0" role="button" aria-label={`Edit assignment for ${photo.filename}`}>
          <div class="catalog-thumbnail"><img src={photo.imageUrl} alt={`Catalog preview of ${photo.filename}`} loading="lazy" /></div>
          <div class="catalog-details">
            <div class="card-title"><h2>{photo.filename}</h2><span class="assignment-badge">Unassigned</span></div>
            <dl>
              <div><dt>Dimensions</dt><dd>{photo.width} × {photo.height}</dd></div>
              <div><dt>Orientation</dt><dd>{photo.orientation}</dd></div>
              <div><dt>File size</dt><dd>{photo.fileSize}</dd></div>
              <div><dt>Public path</dt><dd><code>{photo.publicPath}</code></dd></div>
            </dl>
            <p class="assignment-detail">Select to assign a role.</p>
          </div>
        </article>
      ))}
    </section>
    <p class="empty-library" id="emptyLibrary" hidden>No photographs match the current controls.</p>
  </main>

  <dialog id="assignmentDialog" aria-labelledby="editorTitle">
    <div class="editor-shell">
      <div class="preview-column">
        <img id="editorPreview" src="" alt="" />
        <div class="preview-navigation">
          <button type="button" id="previousPhoto" aria-label="Previous photo">← Previous</button>
          <span id="previewPosition"></span>
          <button type="button" id="nextPhoto" aria-label="Next photo">Next →</button>
        </div>
      </div>
      <form id="assignmentForm" class="assignment-form">
        <div class="editor-header"><div><div class="eyebrow rust">Photo assignment</div><h2 id="editorTitle"></h2></div><button type="button" id="closeEditor" aria-label="Close assignment editor">×</button></div>
        <label>Destination<input name="destination" value="Leiden" readonly /></label>
        <label>Role<select name="role" required><option value="unassigned">Unassigned</option><option value="destination-hero">Destination Hero</option><option value="feeling">Feeling Image</option><option value="chloes-take">Chloe’s Take</option><option value="recommendation">Recommendation Image</option><option value="story">Story Image</option><option value="do-not-use">Do Not Use</option></select></label>
        <label id="relatedField" hidden>Related item<select name="relatedId"></select></label>
        <label id="customStoryField" hidden>Custom short story label<input name="customStoryLabel" maxlength="100" /></label>
        <fieldset id="priorityField" hidden><legend>Priority</legend><label><input type="radio" name="priority" value="primary" /> Primary</label><label><input type="radio" name="priority" value="secondary" /> Secondary</label></fieldset>
        <label>Alt text <span id="altRequirement">Optional while unassigned</span><textarea name="alt" rows="3"></textarea></label>
        <p class="field-help">Write final alt text yourself. The tool does not generate it.</p>
        <label>Notes <span>Optional</span><textarea name="notes" rows="3"></textarea></label>
        <div class="form-actions"><button type="submit" class="primary-action">Save draft assignment</button><button type="button" id="removeAssignment">Set to unassigned</button></div>
      </form>
    </div>
  </dialog>

  <script is:inline id="photoCatalogData" type="application/json" set:html={JSON.stringify(clientData).replaceAll('<', '\\u003c')} />
  <script is:inline set:html={clientScript} />
  <style is:inline set:html={clientStyles} />
</BaseLayout>
