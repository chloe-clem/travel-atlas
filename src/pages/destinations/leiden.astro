---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DestinationExperience from '../../components/DestinationExperience.astro';
import { destinations } from '../../data/destinations';
import { getDestinationExperience } from '../../data/destinationExperiences';
import { getRecommendationsByDestination } from '../../data/recommendations';

const base = import.meta.env.BASE_URL;
const destination = destinations.find(({ slug }) => slug === 'leiden')!;
const experience = getDestinationExperience(destination.slug);
const leidenRecommendations = getRecommendationsByDestination(destination.slug);
---

<BaseLayout title={`${destination.name} | Chloe's Travel Atlas`}>
  <DestinationExperience
    destination={destination}
    experience={experience}
    recommendations={leidenRecommendations}
  />

  <script is:inline src={`${base}scripts/destination-nav.js`}></script>
  <script src="../../scripts/leiden.js"></script>
</BaseLayout>
