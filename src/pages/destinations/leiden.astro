---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialTake from '../../components/EditorialTake.astro';
import RecommendationCard from '../../components/RecommendationCard.astro';
import RecommendationExplorerHeader from '../../components/RecommendationExplorerHeader.astro';
import { destinations } from '../../data/destinations';
import { getRecommendationsByDestination } from '../../data/recommendations';
const base=import.meta.env.BASE_URL;
const openFreeMapStyle='https://tiles.openfreemap.org/styles/positron';
const destination=destinations.find(({slug})=>slug==='leiden')!;
const leidenRecommendations=getRecommendationsByDestination(destination.slug);
const takeParagraphs=[
  'I spent five months living in Leiden while studying abroad, and it became one of my favorite places I’ve ever lived.',
  'If you’re looking for world-famous museums and nonstop energy, Amsterdam is hard to beat. But if your favorite travel memories come from wandering quiet streets, becoming a regular at a neighborhood café, biking along peaceful canals, and feeling like you’ve settled into everyday life somewhere new, I’d choose Leiden every time.',
  'One of the things I loved most was that it still felt unmistakably Dutch. You hear Dutch being spoken all around you, watch student associations fill the streets, and get a glimpse of everyday life in a way that’s harder to find in larger tourist cities. It’s the kind of place that quietly grows on you until, before you know it, you’re already planning your next visit.',
];
---
<BaseLayout title={`${destination.name} | Chloe's Travel Atlas`}>
<a class="destination-back" href={`${base}?return=atlas#atlas-list`} id="destinationBack" data-base={base}>← Back to atlas</a>


<nav class="nav"><a class="brand" href={base}>Chloe's Travel Atlas</a><div class="navlinks"><a href={`${base}?return=feel#feel`}>Feelings</a><a href="#take">Chloe's Take</a><a href="#map">Map</a><a href="#recommendations">Recommendations</a><a href="#stories">Stories</a></div></nav>


<header class="city-hero"><img alt="Sunset reflected in a Leiden canal" src={`${base}photos/leiden/img_0541.jpg`}/><div class="wrap city-head fade"><div class="eyebrow">The Netherlands</div><h1>{destination.name}</h1><p>A smaller, calmer version of Amsterdam, with canals around every corner and a pace that made the city feel easy to live in.</p><div class="city-meta">{destination.characteristics?.map(characteristic=><span>{characteristic}</span>)}</div></div></header>


<main>
<EditorialTake label="Chloe's take" heading="Why I’d Choose Leiden Over Amsterdam" quote="“Everything I loved about Amsterdam, without feeling like a tourist.”" paragraphs={takeParagraphs} imageSrc={`${base}photos/leiden/img_3412.jpg`} imageAlt="Canal, bicycles, flowers, and historic buildings viewed from a green bridge in Leiden." />
<section class="recommendation-explorer" id="recommendations">
<RecommendationExplorerHeader destinationName={destination.name} recommendations={leidenRecommendations} />
<section class="section recommendations" id="recommendationCards"><div class="wrap"><div class="eyebrow rust">Recommendations</div><div class="rec-heading"><h2 class="fade">Choose what matters to you.</h2></div><div class="place-grid">
{leidenRecommendations.map((recommendation)=><RecommendationCard base={base} recommendation={recommendation} />)}
</div></div></section>
<section class="section map-section" id="map"><div class="wrap map-layout"><div class="map-copy fade"><div class="eyebrow rust">Every place, on one map</div><h2>See where the memories happened.</h2><p>Verified recommendations are pinned on the map, so you can see how the city fits together. Explore cafés, museums, hidden gems, and favorite spots in context, not just as a list.</p></div><div aria-label="Interactive map of Leiden recommendations" class="city-map fade" data-map-style={openFreeMapStyle} id="cityMap">
<div class="map-canvas" id="mapCanvas"></div>
<div class="map-setup" id="mapSetup" hidden><div class="eyebrow rust">Map locations coming soon</div><h3>Verified Leiden pins are on the way.</h3><p>Recommendations will appear here after their exact coordinates are confirmed.</p></div>
<div class="map-card is-cleared" id="mapCard"><img alt=""/><div><span>Selected place</span><h3></h3><p></p><div class="map-card-actions"><button type="button">View recommendation</button><a data-map-link="google" href="#" rel="noopener noreferrer" target="_blank">Open in Google Maps</a><a data-map-link="apple" href="#" rel="noopener noreferrer" target="_blank">Open in Apple Maps</a></div></div></div>
</div></div></section>
</section>
<section class="section wrap" id="stories"><div class="eyebrow rust">Stories left untold</div><div class="stories-heading"><h2 class="fade">The memories beyond the guide.</h2><p class="fade">Select a photograph to see the story, recommendation, or context behind it.</p></div><div class="story-gallery fade" id="storyGallery">
<button data-img={`${base}photos/leiden/img_7289.jpg`} data-story="This space is designed for the personal context only you can add later." data-title="A canal I kept returning to"><img alt="Canal boats" src={`${base}photos/leiden/img_7289.jpg`}/><span>Story available</span></button>
<button data-img={`${base}photos/leiden/img_0113.jpg`} data-story="Flowers, food, and the rhythm of Leiden's Wednesday and Saturday markets." data-title="Market morning"><img alt="Flowers at a market" src={`${base}photos/leiden/img_0113.jpg`}/><span>Story available</span></button>
<button data-img={`${base}photos/leiden/img_7463.jpg`} data-story="A small scene that captures what living in a Dutch city felt like." data-title="Everyday bike life"><img alt="Bicycles" src={`${base}photos/leiden/img_7463.jpg`}/><span>Story available</span></button>
<button data-img={`${base}photos/leiden/img_7295.jpg`} data-story="This photo can stay visual or hold a memory once you add the context." data-title="Quiet corner"><img alt="Garden" src={`${base}photos/leiden/img_7295.jpg`}/><span>Story available</span></button>
<button data-img={`${base}photos/leiden/img_0541.jpg`} data-story="A full-screen memory that could connect back to the hero image." data-title="Canal at sunset"><img alt="Canal sunset" src={`${base}photos/leiden/img_0541.jpg`}/><span>Story available</span></button>
<button data-img={`${base}photos/leiden/img_7455.jpg`} data-story="The exact place and why you chose this image can be filled in later." data-title="A meal worth remembering"><img alt="Meal" src={`${base}photos/leiden/img_7455.jpg`}/><span>Story available</span></button>
</div></section>
</main>


<div class="story-modal" hidden="" id="storyModal"><button aria-label="Close" class="modal-close">×</button><img alt=""/><div><span>Stories left untold</span><h2></h2><p></p></div></div>


<footer class="footer"><div>Chloe's Travel Atlas</div><a href={base}>Back to the globe ↑</a></footer>


  <script is:inline src={`${base}scripts/destination-nav.js`}></script>
  <script src="../../scripts/leiden.js"></script>
</BaseLayout>
