---
import '../styles/global.css';
interface Props { title: string; description?: string; bodyClass?: string; }
const { title, description='A living atlas of places, memories, and changing perspectives.', bodyClass='' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const r = new URLSearchParams(location.search).get('return');
        if (r === 'feel' || r === 'atlas') document.documentElement.classList.add('skip-home-intro');
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
