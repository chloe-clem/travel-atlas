---
import { destinations } from '../data/destinations';
const continents = [...new Set(destinations.map(d=>d.continent))].sort();
const countries = [...new Set(destinations.map(d=>d.country))].sort();
const base=import.meta.env.BASE_URL;
---
<section class="destination-ribbon" id="atlas-list"><div class="wrap">
  <div class="ribbon-head"><div><div class="eyebrow rust">Explore by location</div><h2>The complete atlas</h2></div><p>Search every destination directly, or narrow the list by continent and country.</p></div>
  <div class="atlas-search-row"><label class="atlas-search">Search destinations<input id="destinationSearch" type="search" placeholder="Try Leiden, Switzerland, mountains…" /></label><div class="geography-filters"><label>Continent<select id="continentFilter"><option value="all">All continents</option>{continents.map(v=><option value={v}>{v}</option>)}</select></label><label>Country<select id="countryFilter"><option value="all">All countries</option>{countries.map(v=><option value={v}>{v}</option>)}</select></label><button id="clearGeo" type="button">Clear</button></div></div>
  <p class="result-count" id="resultCount"></p><div class="destination-list" id="destinationList">{destinations.map(d => (<a class="destination-line" href={`${base}destinations/${d.slug}/?from=atlas`} data-status="documented" data-search={`${d.name} ${d.country} ${d.continent} ${d.note} ${d.feelings.join(' ')}`} data-continent={d.continent} data-country={d.country}><span>{d.country}</span><strong>{d.name}</strong><em>{d.note}</em><i>Explore →</i></a>))}</div>
</div></section>
<script>
  const items=[...document.querySelectorAll('.destination-line')]; const search=document.querySelector('#destinationSearch'); const continent=document.querySelector('#continentFilter'); const country=document.querySelector('#countryFilter'); const count=document.querySelector('#resultCount');
  const render=()=>{const q=(search?.value||'').trim().toLowerCase();let visible=0;items.forEach(item=>{const ok=(!q||item.dataset.search?.toLowerCase().includes(q))&&(continent?.value==='all'||item.dataset.continent===continent?.value)&&(country?.value==='all'||item.dataset.country===country?.value);item.hidden=!ok;if(ok)visible++;});if(count)count.textContent=`${visible} ${visible===1?'place':'places'} in view`;}; search?.addEventListener('input',render);continent?.addEventListener('change',render);country?.addEventListener('change',render);document.querySelector('#clearGeo')?.addEventListener('click',()=>{if(search)search.value='';if(continent)continent.value='all';if(country)country.value='all';render();});render();
</script>
