---
import { feelings } from '../data/feelings';
const base=import.meta.env.BASE_URL;
const assetUrl=(image:string)=>`${base}${image.replace(/^\//,'')}`;
---
<section class="feelings-section" id="feel"><div class="wrap"><div class="feelings-heading"><h2>Start with how you want to feel.</h2></div><div class="collection-grid">{feelings.map(feeling=>(<a class:list={['collection-card',feeling.slug]} href={`${base}feelings/${feeling.slug}/`} style={`--feeling-image:url('${assetUrl(feeling.image)}')`}><div><span>A curated collection</span><h3>{feeling.title}</h3><p>{feeling.cardCopy}</p><em>{feeling.action} →</em></div></a>))}</div><a class="continue-atlas" href="#atlas-list"><strong>Know where you want to go?</strong><span>Keep scrolling to browse the complete atlas ↓</span></a></div></section>
