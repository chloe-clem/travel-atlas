---
const { destination=false } = Astro.props;
const base=import.meta.env.BASE_URL;
---
<footer class="footer"><div>Chloe's Travel Atlas</div><a class={destination ? '' : 'earth-home-link'} href={destination ? `${base}#top` : '#top'}>{destination ? 'Back to the globe ↑' : 'Back to Earth ↑'}</a></footer>
